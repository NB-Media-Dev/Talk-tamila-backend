# Copy to .env and fill in. NEVER commit the real .env file.
ENVIRONMENT=development            # set to "production" on Railway
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_SSL_CA=                   # path to the provider's ca.pem (recommended for Aiven)
SECRET_KEY=                        # 32+ random characters; required in production
ADMIN_BOOTSTRAP_PASSWORD=          # required in production to create the first admin
BACKEND_CORS_ORIGINS=["https://your-frontend.example.com"]
ENABLE_DOCS=                       # leave empty: docs on in development, off in production
POST_SCHEDULER_ENABLED=true
POST_SCHEDULER_INTERVAL_SECONDS=30
RATE_LIMIT_ENABLED=true
BREVO_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=